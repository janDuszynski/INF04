<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="czerwiec22.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="0, 20, 0, 0">
            <Label Text="Domek w górach" FontSize="Title" TextColor="Gray" Margin="5, 0, 5, 5"/>
            <Image Source="obraz.jpg" Aspect="AspectFill" HeightRequest="150"/>
            <HorizontalStackLayout BackgroundColor="#008080" HorizontalOptions="Fill">
                <Button Text="POLUB" TextColor="White" BackgroundColor="#008080" WidthRequest="120" Clicked="Polub_Clicked"/>
                <Button Text="USUŃ" TextColor="White" BackgroundColor="#008080" WidthRequest="120" Clicked="Usun_Clicked"/>
                <Button Text="ZAPISZ" TextColor="White" BackgroundColor="#008080" WidthRequest="120"/>
            </HorizontalStackLayout>
            <Label x:Name="likesLabel" Text="0 polubień" HorizontalOptions="End" HorizontalTextAlignment="End" Margin="5"/>
            <BoxView HeightRequest="1" Color="#808080"/>
            <Label Text="Opis" FontAttributes="Bold" Margin="5, 10, 5, 0"/>
            <Label Text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych" TextColor="#808080" Margin="5"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
